#!/bin/sh
# Runs before every `git push` and blocks it if version.py wasn't bumped.
# Switched on by `npm install` (see scripts/install-hooks.js).
# Skip it for one push with: git push --no-verify

if ! command -v node >/dev/null 2>&1; then
	echo "pre-push: node isn't on your PATH, so the version check can't run." >&2
	echo "          Install Node 22, or push with --no-verify." >&2
	exit 1
fi

exec node "$(git rev-parse --show-toplevel)/scripts/check-version.js" --pre-push "$@"
