---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Quote from "../components/Quote.astro";
import { WORKER_URL } from "../lib/subscribe-worker.mjs";

const roles = await getCollection("career");
const sorted = roles.sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate),
);
const history = await Promise.all(
  sorted.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

// startDate/endDate are "YYYY-MM" strings (see src/content.config.ts)
const fmtMonth = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return new Date(Date.UTC(y, (m || 1) - 1, 1)).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    timeZone: "UTC",
  });
};
const fmtRange = (start: string, end?: string) =>
  `${fmtMonth(start)} – ${end ? fmtMonth(end) : "Present"}`;

const fmtElapsed = (start: string, end?: string) => {
  const [sy, sm] = start.split("-").map(Number);
  const now = new Date();
  const [ey, em] = end
    ? end.split("-").map(Number)
    : [now.getUTCFullYear(), now.getUTCMonth() + 1];
  let months = (ey - sy) * 12 + (em - sm) + 1;
  if (months < 1) months = 1;
  const years = Math.floor(months / 12);
  const remMonths = months % 12;
  const parts = [];
  if (years > 0) parts.push(`${years} yr${years === 1 ? "" : "s"}`);
  if (remMonths > 0 || years === 0)
    parts.push(`${remMonths} mo${remMonths === 1 ? "" : "s"}`);
  return parts.join(" ");
};

// raw entry data for the dev editor's pre-filled form; never built
const devJson = import.meta.env.DEV
  ? JSON.stringify(
      sorted.map((entry) => ({
        id: entry.id,
        role: entry.data.role,
        company: entry.data.company,
        companyUrl: entry.data.companyUrl ?? "",
        location: entry.data.location ?? "",
        startDate: entry.data.startDate,
        endDate: entry.data.endDate ?? "",
        tags: (entry.data.tags ?? []).join(", "),
        hasLogo: Boolean(entry.data.logo),
        body: entry.body ?? "",
      })),
    ).replace(/</g, "\\u003c")
  : "";
---

<BaseLayout
  title="Working"
  description="My résumé, professional background, and work history."
>
  <span class="mono-label">index / 01</span>
  <h1>Working</h1>
  <p class="lede">A résumé, a bit about me, and a brief history.</p>

  <section class="intro-row">
    <div class="resume-panel">
      <span class="mono-label section-label">résumé</span>
      <div class="resume-window">
        <iframe
          src="https://aselling-us.github.io/resume/ArjanEllingsonResume.pdf#toolbar=0&navpanes=0"
          title="Arjan Ellingson's résumé"
          loading="lazy"></iframe>
      </div>
      <a
        class="resume-link mono-label"
        href="https://aselling-us.github.io/resume/ArjanEllingsonResume.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        open full résumé ↗
      </a>

      <div class="reference-box">
        <button type="button" id="reference-toggle" class="reference-cta">
          Request Professional References
        </button>
        <form class="reference-form" id="reference-form" novalidate hidden>
          <input
            class="reference-input"
            id="reference-name"
            name="name"
            type="text"
            placeholder="Your name (optional)"
            autocomplete="name"
          />
          <input
            class="reference-input"
            id="reference-email"
            name="email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <input
            class="reference-input"
            id="reference-message"
            name="message"
            type="text"
            placeholder="Role / company you're evaluating me for (optional)"
          />
          <!-- honeypot: see SubscribeForm.astro for why it's named/hidden this way -->
          <input
            class="reference-hp"
            name="hp-note-b2"
            type="text"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            data-1p-ignore="true"
            data-lpignore="true"
            data-bwignore="true"
            data-form-type="other"
          />
          <div class="reference-actions">
            <button type="submit" id="reference-submit">send request</button>
            <button type="button" id="reference-cancel">cancel</button>
          </div>
        </form>
        <p class="reference-status mono-label" id="reference-status" role="status" aria-live="polite"></p>
      </div>

      {import.meta.env.DEV && (
        <div class="dev-reference-test">
          <span class="mono-label">dev: test reference request email</span>
          <button type="button" id="send-reference-test" class="dev-btn">
            send test email to me
          </button>
        </div>
      )}
    </div>

    <div class="about-panel">
      <span class="mono-label section-label">about</span>
      <p>
        I've always been passionate about figuring out how technology can help
        us create better versions of ourselves. Whether this includes
        productivity tools, avoiding addictive pitfalls, or creating QOL improvements, 
        I want to create tools (not limited to software) that
        help people live deeper, introspective and more present lives.
      </p>
      <p>
        This philosophy has guided my career, from education to defense and
        wherever the future leads me. My current work as a textbook developer
        for Kontinua has inspired me to pursue life-long learning in support 
        of education. At Redwire, I have been able to alter processes that 
        affect the entire company for the better. On my own time, I have 
        reorganized my own life to be more efficient and minimize
        distractions around me.
      </p>
      <Quote cite="— Søren Kierkegaard">
        Life can only be understood backwards; but it must be lived forwards.
      </Quote>
        <p>
        In my efforts to stay off of Social Networking Services, I have gradually eliminated 
        certain apps including LinkedIn. While it is a useful tool, I have replicated a similar 
        functionality here. The following section is a chronological history of my professional
        work experience.
      </p>
    </div>
  </section>

  <section class="history">
    <div class="history-header">
      <h2 class="mono-label section-label">
        experience / {String(history.length).padStart(2, "0")}
      </h2>
      {import.meta.env.DEV && (
        <button
          class="dev-btn mono-label"
          type="button"
          id="add-experience"
          title="Dev only: writes src/content/career/<slug>.md"
        >
          + new position
        </button>
      )}
    </div>

    {
      history.length === 0 && (
        <p class="empty-state">
          No entries yet — add a markdown file to{" "}
          <code>src/content/career/</code> (see the schema in{" "}
          <code>src/content.config.ts</code>).
        </p>
      )
    }

    <ul class="history-list">
      {
        history.map(({ entry, Content }) => (
          <li class="history-item">
            {entry.data.logo && (
              <Image
                src={entry.data.logo}
                alt={`${entry.data.company} logo`}
                width={56}
                height={56}
                class="history-logo"
              />
            )}
            <div class="history-main">
              <div class="history-head">
                <h3 class="history-role">{entry.data.role}</h3>
                <span class="history-company">
                  {entry.data.companyUrl ? (
                    <a
                      href={entry.data.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {entry.data.company}
                    </a>
                  ) : (
                    entry.data.company
                  )}
                </span>
                {import.meta.env.DEV && (
                  <button
                    class="history-edit dev-btn mono-label"
                    data-id={entry.id}
                    type="button"
                  >
                    edit
                  </button>
                )}
              </div>
              <div class="mono-label history-meta">
                <span>
                  {fmtRange(entry.data.startDate, entry.data.endDate)} ·{" "}
                  {fmtElapsed(entry.data.startDate, entry.data.endDate)}
                </span>
                {entry.data.location && (
                  <span>· {entry.data.location}</span>
                )}
              </div>
              <div class="prose">
                <Content />
              </div>
              {entry.data.tags && entry.data.tags.length > 0 && (
                <ul class="tag-list">
                  {entry.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    {import.meta.env.DEV && <script type="application/json" id="career-dev-data" set:html={devJson} />}
  </section>
</BaseLayout>

<script define:vars={{ WORKER_URL }}>
  // "Request Professional References" — ships to production, backed by the
  // same Cloudflare Worker as the blog's subscribe form (see
  // src/components/SubscribeForm.astro). Progressive disclosure: the button
  // is the only thing visible until clicked, then it's replaced by the form.
  const referenceToggle = document.getElementById('reference-toggle');
  const referenceForm = document.getElementById('reference-form');
  const referenceCancel = document.getElementById('reference-cancel');
  const referenceEmail = document.getElementById('reference-email');
  const referenceSubmit = document.getElementById('reference-submit');
  const referenceStatus = document.getElementById('reference-status');

  referenceToggle?.addEventListener('click', () => {
    referenceToggle.hidden = true;
    referenceForm.hidden = false;
    referenceEmail?.focus();
  });

  referenceCancel?.addEventListener('click', () => {
    referenceForm.reset();
    referenceForm.hidden = true;
    referenceToggle.hidden = false;
    referenceStatus.textContent = '';
  });

  referenceForm?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!referenceEmail.checkValidity()) {
      referenceStatus.textContent = 'enter a valid email address';
      return;
    }

    referenceSubmit.disabled = true;
    referenceStatus.textContent = 'sending…';

    try {
      const res = await fetch(new URL('/request-references', WORKER_URL), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: referenceForm['name'].value.trim(),
          email: referenceEmail.value.trim(),
          message: referenceForm['message'].value.trim(),
          website: referenceForm['hp-note-b2'].value,
        }),
      });

      if (!res.ok) {
        const { error } = await res.json().catch(() => ({ error: undefined }));
        throw new Error(error || `status ${res.status}`);
      }

      referenceStatus.textContent = "thanks — I'll be in touch";
      referenceForm.reset();
      referenceForm.hidden = true;
      referenceToggle.hidden = false;
    } catch (err) {
      referenceStatus.textContent = err instanceof Error && err.message ? err.message : 'something went wrong — try again in a moment';
    } finally {
      referenceSubmit.disabled = false;
    }
  });
</script>

<script>
  // dev-only "test the reference-request email" trigger — import.meta.env.DEV
  // is statically false in builds, so none of this ships
  if (import.meta.env.DEV) {
    document.getElementById('send-reference-test')?.addEventListener('click', async () => {
      const button = document.getElementById('send-reference-test') as HTMLButtonElement;
      button.disabled = true;
      button.textContent = 'sending…';
      try {
        const res = await fetch('/__test-reference-request-email', { method: 'POST' });
        if (!res.ok) {
          const { error } = await res.json().catch(() => ({ error: res.statusText }));
          alert(`Could not send test email: ${error}`);
          return;
        }
        const { to } = await res.json();
        if (confirm(`Test reference-request email sent to ${to}. Open Gmail to check?`)) {
          window.open('https://mail.google.com/mail/u/0/#inbox', '_blank');
        }
      } finally {
        button.disabled = false;
        button.textContent = 'send test email to me';
      }
    });
  }
</script>

<script>
  // dev-only career editor — import.meta.env.DEV is statically false in
  // builds, so none of this ships
  if (import.meta.env.DEV) {
    interface CareerData {
      id: string;
      role: string;
      company: string;
      companyUrl: string;
      location: string;
      startDate: string;
      endDate: string;
      tags: string;
      hasLogo: boolean;
      body: string;
    }

    const entries: CareerData[] = JSON.parse(
      document.getElementById('career-dev-data')?.textContent ?? '[]'
    );
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    const dialog = document.createElement('dialog');
    dialog.className = 'career-editor';
    document.body.append(dialog);

    const open = (entry?: CareerData) => {
      dialog.innerHTML = `
        <form id="career-form">
          <span class="mono-label">${entry ? `edit · src/content/career/${esc(entry.id)}.md` : 'new position'}</span>
          <input name="role" placeholder="Role / title" required value="${esc(entry?.role ?? '')}" />
          <div class="row">
            <input name="company" placeholder="Company" required value="${esc(entry?.company ?? '')}" />
            <input name="companyUrl" placeholder="Company URL (optional)" value="${esc(entry?.companyUrl ?? '')}" />
          </div>
          <input name="location" placeholder="Location (optional)" value="${esc(entry?.location ?? '')}" />
          <div class="row">
            <label class="mono-label date-label">start
              <input name="startDate" type="month" required value="${esc(entry?.startDate ?? new Date().toISOString().slice(0, 7))}" />
            </label>
            <label class="mono-label date-label">end (blank = present)
              <input name="endDate" type="month" value="${esc(entry?.endDate ?? '')}" />
            </label>
          </div>
          <label class="mono-label tags-label">tags (separate by commas)
            <input name="tags" placeholder="Education, Python, ..." value="${esc(entry?.tags ?? '')}" />
          </label>
          <label class="mono-label logo-label">logo ${entry?.hasLogo ? '(leave empty to keep current)' : ''}
            <input type="file" name="logo" accept="image/*" />
          </label>
          <textarea name="body" rows="10" placeholder="Description (markdown)">${esc(entry?.body ?? '')}</textarea>
          <div class="row">
            <button type="submit">save</button>
            <button type="button" id="career-cancel">cancel</button>
          </div>
        </form>`;
      dialog.showModal();

      document.getElementById('career-cancel')?.addEventListener('click', () => dialog.close());

      document.getElementById('career-form')?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(ev.currentTarget as HTMLFormElement);
        const logo = fd.get('logo') as File | null;
        const res = await fetch('/__edit-career/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: entry?.id,
            role: fd.get('role'),
            company: fd.get('company'),
            companyUrl: fd.get('companyUrl'),
            location: fd.get('location'),
            startDate: fd.get('startDate'),
            endDate: fd.get('endDate'),
            tags: fd.get('tags'),
            body: fd.get('body'),
          }),
        });
        if (!res.ok) {
          const { error } = await res.json().catch(() => ({ error: res.statusText }));
          alert(`Could not save entry: ${error}`);
          return;
        }
        const { slug } = await res.json();
        if (logo && logo.size > 0) {
          const up = await fetch(
            `/__edit-career/image?slug=${encodeURIComponent(slug)}&name=${encodeURIComponent(logo.name)}`,
            { method: 'POST', body: logo }
          );
          if (!up.ok) {
            const { error } = await up.json().catch(() => ({ error: up.statusText }));
            alert(`Entry saved, but the logo failed: ${error}`);
          }
        }
        location.reload();
      });
    };

    document.querySelectorAll<HTMLButtonElement>('.history-edit').forEach((btn) =>
      btn.addEventListener('click', () => {
        const entry = entries.find((e) => e.id === btn.dataset.id);
        if (entry) open(entry);
      })
    );
    document.getElementById('add-experience')?.addEventListener('click', () => open());
  }
</script>

<style>
  .lede {
    color: var(--color-text-dim);
  }
  .section-label {
    color: var(--color-highlight-bright);
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--space-1);
    margin: 0 0 var(--space-3);
    font-size: 0.7rem;
    font-weight: 400;
    display: block;
  }
  section {
    margin-top: var(--space-4);
  }
  .history-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--space-1);
    margin: 0 0 var(--space-3);
  }
  .history-header .section-label {
    border-bottom: none;
    padding-bottom: 0;
    margin: 0;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-bg-inset);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
  }

  /* résumé + about, side by side */
  .intro-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .resume-panel {
    flex: 0 0 410px;
  }
  .resume-window {
    border: 1px solid var(--color-hairline);
    background: var(--color-bg-inset);
    padding: 6px;
    aspect-ratio: 8.5 / 11;
  }
  .resume-window iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    background: #fff;
  }
  .resume-link {
    display: inline-block;
    margin-top: var(--space-1);
    color: var(--color-accent-bright);
  }
  .resume-link:hover {
    color: var(--color-highlight-bright);
  }

  .about-panel {
    flex: 1 1 320px;
    min-width: 260px;
  }
  .about-panel p {
    color: var(--color-text-dim);
    max-width: 60ch;
  }

  /* career history list */
  .history-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
  }
  .history-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .history-logo {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border: 1px solid var(--color-hairline);
    background: #fff;
  }
  .history-main {
    flex: 1;
    min-width: 0;
  }
  .history-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .history-role {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0;
  }
  .history-company {
    color: var(--color-accent-bright);
    font-size: 0.95rem;
  }
  .history-company a:hover {
    color: var(--color-highlight-bright);
  }
  .history-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }

  .prose {
    margin-top: 0.6rem;
    max-width: 65ch;
  }
  .prose :global(p) {
    margin: 0 0 0.6rem;
    color: var(--color-text-dim);
  }
  .prose :global(ul) {
    margin: 0 0 0.6rem;
    padding-left: 1.2rem;
    color: var(--color-text-dim);
  }
  .prose :global(li) {
    margin: 0.2rem 0;
  }
  .prose :global(a) {
    color: var(--color-accent-bright);
  }
  .prose :global(a:hover) {
    color: var(--color-highlight-bright);
  }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-highlight-bright);
    border: 1px solid var(--color-highlight-bright);
    border-radius: 9999px;
    padding: 0.2rem 0.75rem;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .tag:hover {
    background: var(--color-highlight-bright);
    color: var(--color-bg);
  }

  .empty-state {
    color: var(--color-text-dim);
    margin-top: var(--space-3);
  }

  /* request professional references */
  .reference-box {
    margin-top: var(--space-3);
  }
  .reference-cta {
    display: block;
    width: fit-content;
    margin: 0 auto;
    background: var(--color-highlight-bright);
    border: none;
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.6rem 1rem;
    cursor: pointer;
  }
  .reference-cta:hover {
    opacity: 0.9;
  }
  /* same [hidden]-losing-to-`display` issue as .reference-form[hidden] below */
  .reference-cta[hidden] {
    display: none;
  }
  .reference-form {
    display: grid;
    gap: 0.6rem;
    max-width: 420px;
  }
  /* [hidden] alone loses to the `display: grid` above (same specificity,
     source order breaks the tie) — spell it out so the toggle actually hides
     the form instead of showing both the button and the form at once. */
  .reference-form[hidden] {
    display: none;
  }
  .reference-input {
    width: 100%;
    background: var(--color-bg-inset);
    border: 1px solid var(--color-hairline-bright);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem 0.65rem;
  }
  .reference-input:focus-visible {
    outline: 2px solid var(--color-highlight-bright);
    outline-offset: 1px;
  }
  /* honeypot: off-screen rather than display:none, which unsophisticated
     bots often specifically check for and skip filling */
  .reference-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .reference-actions {
    display: flex;
    gap: 0.6rem;
  }
  .reference-actions button[type='submit'] {
    background: var(--color-highlight-bright);
    border: none;
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }
  .reference-actions button[type='submit']:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .reference-actions button[type='button'] {
    background: none;
    border: 1px solid var(--color-hairline-bright);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }
  .reference-actions button[type='button']:hover {
    color: var(--color-highlight-bright);
    border-color: var(--color-highlight);
  }
  .reference-status {
    min-height: 1.2em;
    margin: 0.6rem 0 0;
    color: var(--color-text-dim);
  }
  .dev-reference-test {
    margin-top: 0.6rem;
    padding: var(--space-2);
    border: 1px dashed var(--color-hairline-bright);
  }
  .dev-reference-test .dev-btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .intro-row {
      flex-direction: column;
    }
    .resume-panel {
      flex: 1 1 100%;
      width: 100%;
      max-width: 260px;
    }
    .history-item {
      flex-direction: column;
    }
