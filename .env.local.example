# Copy to .env.local (gitignored, never commit it) to test the dev-only
# "send test email" buttons — the post editor's send-test-email row and the
# confirmation-email test next to SubscribeForm on /blog. `npm run dev`
# loads this automatically (node --env-file-if-exists=.env.local) if the
# file exists; nothing changes if it doesn't.
#
# Use the same values as the SMTP_*/MAIL_FROM GitHub Actions secrets, or a
# separate local-only credential from the same provider (e.g. a second
# Resend API key) — either works, see CLAUDE.md's "Email subscriptions"
# section for what each var does in production.

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
MAIL_FROM=Your Name <hello@yourdomain.com>




# Copy to .env.local (gitignored, never commit it) to test the dev-only
# "send test email" buttons — the post editor's send-test-email row and the
# confirmation-email test next to SubscribeForm on /blog. `npm run dev`
# loads this automatically (node --env-file-if-exists=.env.local) if the
# file exists; nothing changes if it doesn't.
#
# Use the same values as the SMTP_*/MAIL_FROM GitHub Actions secrets, or a
# separate local-only credential from the same provider (e.g. a second
# Resend API key) — either works, see CLAUDE.md's "Email subscriptions"
# section for what each var does in production.

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
MAIL_FROM=name <blog@name.io>
MAIL_REPLY_TO=where email replies should go
GH_CONTRIB_TOKEN=gh token with repo scope, for testing the "notify blog subscribers" button
WORKER_URL=
UNSUBSCRIBE_SECRET=
HARDCOVER_TOKEN=https://hardcover.app/account/api
EMAIL=your contact email, sent in media-snapshot User-Agents and shown in the RSS feed's author
DOMAIN_ROOT=thewebsite domain


SPOTIFY_CLIENT_ID=spotify client id
SPOTIFY_CLIENT_SECRET=spotify client secret
SPOTIFY_REFRESH_TOKEN=

# CODE COEMS FROM
# https://accounts.spotify.com/authorize?response_type=code&client_id=YOUR_CLIENT_ID&redirect_uri=https%3A%2F%2Faselling.us&scope=user-read-currently-playing%20user-read-recently-played%20user-top-read&show_dialog=true


# THEN curl via


# curl -X POST https://accounts.spotify.com/api/token \
#   -u 'CLIENT_ID:CLIENT_SECRET' \
#   -d 'grant_type=authorization_code' \
#   --data-urlencode 'code=CODE FROM ABOVE' \
#   --data-urlencode 'redirect_uri=https://aselling.us'