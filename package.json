{
  "name": "aselling-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "npm run drafts:count && node ./node_modules/vite/bin/vite.js dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "husky && (svelte-kit sync || echo '')",
    "sync": "npx svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "drafts:count": "node src/lib/server/count-drafts.ts",
    "hardcover": "tsx src/lib/server/hardcover.ts",
    "letterboxd": "tsx src/lib/server/letterboxd.ts",
    "fetch:media": "node --env-file-if-exists=.env.local scripts/fetch-media.mjs",
    "notify:blog": "node scripts/notify-blog-subscribers.mjs",
    "notify:confirm": "node scripts/send-subscription-confirmations.mjs",
    "notify:references": "node scripts/send-reference-requests.mjs",
    "subscribers": "npm run subscribers --prefix worker",
    "test:unit": "vitest run",
    "spellcheck": "cspell --no-progress \"src/**/*.{md,svelte,ts,js,mjs}\" \"scripts/**/*.mjs\" \"worker/**/*.{ts,js}\" \"tests/**/*.ts\" \"*.{md,mjs,ts}\"",
    "spellcheck:add-words": "node scripts/cspell-add-words.mjs",
    "version:check": "node scripts/check-version.js"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@hardcover/sdk": "^0.1.1",
    "@lucide/svelte": "^1.77.0",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.12.0",
    "fast-xml-validator": "^1.4.2",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "nodemailer": "^10.6.1",
    "playwright": "^1.65.1",
    "remark-flexible-markers": "^1.3.5",
    "remove-markdown": "^0.8.0",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.5.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
